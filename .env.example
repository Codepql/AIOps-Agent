# Chat model
OPENAI_API_KEY=
BASE_URL=https://api.deepseek.com
LANGCHAIN_MODEL=deepseek-v4-flash

# Embedding model
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# Application
APP_NAME=OneCall AI
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=3001

# PostgreSQL + pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onecall
DATABASE_SSL=false

# RAG
RAG_TOP_K=3
RAG_MODEL=qwen-max
CHUNK_MAX_SIZE=500
CHUNK_OVERLAP=100

# Optional MCP servers
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://127.0.0.1:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://127.0.0.1:8004/mcp

# Optional Prometheus
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10
